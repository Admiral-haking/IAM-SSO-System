# -----------------------------------------------------------------------------
# Centralized IAM / SSO Configuration
# -----------------------------------------------------------------------------

# Application
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://iam_user:SecureIamPass992@localhost:5432/central_iam?schema=public"

# Distributed Cache & Rate Limiting (Redis 7)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="SecureRedisClusterPass99"

# Cryptography & Secrets Management
# Master symmetric secret used to encrypt private RSA keys at rest
JWT_MASTER_ENCRYPTION_KEY="your-32-character-secret-key-here"

# Token TTL Configuration
ACCESS_TOKEN_TTL_SECONDS=900        # 15 minutes
REFRESH_TOKEN_TTL_DAYS=30           # 30 days
AUTH_CODE_TTL_SECONDS=600           # 10 minutes

# Gemini / AI Studio (If applicable)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
